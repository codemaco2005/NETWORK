let termScores=new Set();
function normalizeTerm(v){return String(v).toLowerCase().trim().replace(/[_.]/g," ").replace(/[-–—]/g," ").replace(/\s+/g," ");}
function renderTerms(){
 const host=document.getElementById('termsList');
 host.innerHTML=technicalTermItems.map((q,i)=>`<article class="card" style="margin:12px 0"><div class="qtop"><span>QUESTION ${i+1} OF ${technicalTermItems.length}</span><span>${termScores.has(i)?'<b style="color:var(--green)">Correct</b>':'TECHNICAL TERM'}</span></div><h3>${i+1}. ${q.statement}</h3><span class="ar-small">بالمصري: ${arabicGloss(q.statement.replace(/_+/g,"المصطلح"))}</span><input id="termInput${i}" type="text" placeholder="Type the technical term..." style="width:100%;padding:11px;background:#0c1628;color:var(--text);border:1px solid var(--line);border-radius:9px;margin:8px 0"><div class="toolbar"><button class="btn primary" onclick="checkTerm(${i})">Check answer</button><button class="btn" onclick="revealTerm(${i})">Show answer</button></div><div id="termFeedback${i}"></div></article>`).join('');
 document.getElementById('termsScore').textContent=`Score: ${termScores.size} / ${technicalTermItems.length}`;
}
function checkTerm(i){
 const q=technicalTermItems[i],v=normalizeTerm(document.getElementById(`termInput${i}`).value);
 const ok=q.answer.some(a=>normalizeTerm(a)===v);
 if(ok)termScores.add(i);
 document.getElementById(`termFeedback${i}`).innerHTML=`<div class="feedback"><b style="color:${ok?'var(--green)':'var(--gold)'}">${ok?'Correct!':'Try again.'}</b>${ok?'':` The expected term is ${q.answer[0]}.`}<p>${q.explain}</p>${arLine(q.ar,"الشرح بالمصري:")}</div>`;
 document.getElementById('termsScore').textContent=`Score: ${termScores.size} / ${technicalTermItems.length}`;
}
function revealTerm(i){
 const q=technicalTermItems[i];
 document.getElementById(`termFeedback${i}`).innerHTML=`<div class="worked"><b>Correct term: ${q.answer[0]}</b><p>${q.explain}</p>${arLine(q.ar,"الشرح بالمصري:")}</div>`;
}
function resetTerms(){termScores.clear();renderTerms();}

function fmt(n){if(!Number.isFinite(n))return "Invalid input";if(n===0)return "0";return Number(n.toPrecision(6)).toString();}
function val(id){return Number(document.getElementById(id).value);}
function calcTransmission(){let L=val('calcL'),R=val('calcR');if(L<0||R<=0)return;let s=L/R;document.getElementById('transResult').textContent=`${fmt(s)} seconds = ${fmt(s*1000)} ms`;}
function calcPropagation(){let d=val('calcD'),s=val('calcS');if(d<0||s<=0)return;let x=d/s;document.getElementById('propResult').textContent=`${fmt(x)} seconds = ${fmt(x*1000)} ms`;}
function calcTraffic(){let L=val('trafficL'),a=val('trafficA'),R=val('trafficR');if(L<0||a<0||R<=0)return;let x=L*a/R;let state=x<0.5?'Low load in this model':x<1?'Queueing delay grows as intensity approaches 1':'Overload: arrival work exceeds service capacity';document.getElementById('trafficResult').textContent=`ρ = ${fmt(x)} — ${state}`;}
function calcMesh(){let n=val('meshN');if(!Number.isInteger(n)||n<2)return;document.getElementById('meshResult').textContent=`${n} × (${n} − 1) ÷ 2 = ${n*(n-1)/2} physical channels`;}
function calcThroughput(){let rs=val('rs'),rc=val('rc'),r=val('backbone');if(rs<0||rc<0||r<0)return;let simple=Math.min(rs,rc),shared=Math.min(rs,rc,r/10);document.getElementById('throughputResult').textContent=`Simple path: ${fmt(simple)} Mbps. 10-connection shared scenario: min(${rs}, ${rc}, ${r}/10) = ${fmt(shared)} Mbps.`;}
function calcNodal(){let total=['dp','dq','dt','dpr'].reduce((s,id)=>s+Math.max(0,val(id)),0);document.getElementById('nodalResult').textContent=`Total nodal delay = ${fmt(total)} ms`;}
