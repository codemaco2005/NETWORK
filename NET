function drawMock(){let q=mockQuestions[mockAt];document.getElementById('mockBox').innerHTML=`<div class="qtop"><span>QUESTION ${mockAt+1} / ${mockQuestions.length}</span><span class="timer" id="mockTimer">${Math.floor(mockSeconds/60)}:${String(mockSeconds%60).padStart(2,'0')}</span></div><div class="progress"><span style="width:${(mockAt/mockQuestions.length)*100}%"></span></div><h3>${q[0]}</h3><span class="ar-small">بالمصري: ${arabicGloss(q[0])}</span>${q[1].map((o,i)=>`<button class="mock-option ${mockAnswers[mockAt]===i?'selected':''}" onclick="selectMock(${i})">${String.fromCharCode(65+i)}. ${o}<span class="ar-small">${arabicGloss(o)}</span></button>`).join('')}<div class="quiz-actions"><button class="btn" onclick="mockAt=Math.max(0,mockAt-1);drawMock()" ${mockAt===0?'disabled':''}>Previous</button><button class="btn primary" onclick="${mockAt===mockQuestions.length-1?'finishMock()':'mockAt++;drawMock()'}">${mockAt===mockQuestions.length-1?'Submit exam':'Next question'}</button></div><p class="small-note">Answered ${Object.keys(mockAnswers).length} of ${mockQuestions.length}. You can move back and change answers before submitting.</p>`;}
function selectMock(i){mockAnswers[mockAt]=i;drawMock();}
function finishMock(){if(mockTimer)clearInterval(mockTimer);let score=0;mockQuestions.forEach((q,i)=>{if(mockAnswers[i]===q[2])score++;});let pct=Math.round(score/mockQuestions.length*100);document.getElementById('mockBox').innerHTML=`<div class="eyebrow">MOCK EXAM COMPLETE</div><h2>${score} / ${mockQuestions.length} — ${pct}%</h2><h3>${pct>=90?'Excellent exam readiness':pct>=75?'Strong progress — revise mistakes':'More revision needed — use the explanations below'}</h3><div class="ar-line"><span class="ar-title">بالمصري:</span> دي نتيجة التدريب. راجع كل سؤال غلط وافهم سبب الإجابة الصح قبل ما تعيد الامتحان.</div>${mockQuestions.map((q,i)=>{let ok=mockAnswers[i]===q[2];return `<div class="worked"><b>${i+1}. ${q[0]}</b><p style="color:${ok?'var(--green)':'var(--gold)'}">${ok?'Correct':'Incorrect'} — Correct answer: ${q[1][q[2]]}</p><p>${q[3]}</p><span class="ar-small">${arabicGloss(q[3])}</span></div>`}).join('')}<button class="btn primary" onclick="startMock()">Try a new mock exam</button>`;}

renderNotes();renderExam();renderNumerical();renderTerms();quiz('mcqBox',mcqs,'mcq');quiz('tfBox',tfs,'tf');
document.getElementById('mcqCount').textContent=mcqs.length;document.getElementById('tfCount').textContent=tfs.length;
</script>
</body></html>
