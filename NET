function arabicGloss(text){
  let s = String(text);
  // Replace longer terms first so short words do not break technical phrases.
  for(const [en,ar] of [...arGlossary].sort((a,b)=>b[0].length-a[0].length)){
    s = s.replace(new RegExp(en.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'gi'), ar);
  }
  return s;
}
function arLine(text, label="بالمصري:"){
  return `<span class="ar-line"><span class="ar-title">${label}</span> ${arabicGloss(text)}</span>`;
}
function arChoice(text){ return `<span class="ar-small">${arabicGloss(text)}</span>`; }
function emphasizeKeys(text){
  let s = String(text);
  for(const term of keyTerms){
    const re = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`,'gi');
    s=s.replace(re,'<b class="key">$1</b>');
  }
  return s;
